# Portable adaptation of the existing Mac shell setup.
# Optional Homebrew integrations, only when installed.
if command -v brew >/dev/null 2>&1; then
  _dot_brew="$(brew --prefix)"
  [[ -d "$_dot_brew/share/zsh-completions" ]] && fpath=("$_dot_brew/share/zsh-completions" $fpath)
  [[ -f "$_dot_brew/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "$_dot_brew/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -f "$_dot_brew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "$_dot_brew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  unset _dot_brew
fi
# Machine-specific setup and secrets stay outside this repository.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
